# Values are set once in Secrets Manager (never in Terraform or Git)
# and survive destroy/rebuild of the ephemeral environment.
resource "aws_secretsmanager_secret" "alertmanager_slack" {
  name        = "cymbal-bank/monitoring/alertmanager-slack"
  description = "Slack incoming webhook URL for Alertmanager"
  kms_key_id  = aws_kms_key.secrets.arn
}

# --- Cymbal Bank app secrets: generated by Terraform, stored only in Secrets Manager ---
# "ephemeral" + "*_wo" (write-only): the values never touch Terraform state or plan files.
# The ephemeral values change on every run, but AWS only receives one when
# secret_string_wo_version changes. To rotate a secret: bump its version.

ephemeral "random_password" "accounts_db" {
  length  = 32
  special = false # used inside a postgresql:// URI
}

resource "aws_secretsmanager_secret" "accounts_db" {
  name        = "cymbal-bank/app/accounts-db"
  description = "Postgres password for accounts-db"
  kms_key_id  = aws_kms_key.secrets.arn
}

resource "aws_secretsmanager_secret_version" "accounts_db" {
  secret_id                = aws_secretsmanager_secret.accounts_db.id
  secret_string_wo         = jsonencode({ password = ephemeral.random_password.accounts_db.result })
  secret_string_wo_version = 1
}

ephemeral "random_password" "ledger_db" {
  length  = 32
  special = false # used inside a JDBC URL
}

resource "aws_secretsmanager_secret" "ledger_db" {
  name        = "cymbal-bank/app/ledger-db"
  description = "Postgres password for ledger-db"
  kms_key_id  = aws_kms_key.secrets.arn
}

resource "aws_secretsmanager_secret_version" "ledger_db" {
  secret_id                = aws_secretsmanager_secret.ledger_db.id
  secret_string_wo         = jsonencode({ password = ephemeral.random_password.ledger_db.result })
  secret_string_wo_version = 1
}

# RSA key pair that signs and verifies user login tokens (JWT)
ephemeral "tls_private_key" "jwt" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "aws_secretsmanager_secret" "jwt" {
  name        = "cymbal-bank/app/jwt-key"
  description = "RSA key pair for signing Cymbal Bank JWTs"
  kms_key_id  = aws_kms_key.secrets.arn
}

resource "aws_secretsmanager_secret_version" "jwt" {
  secret_id = aws_secretsmanager_secret.jwt.id
  secret_string_wo = jsonencode({
    private_key = ephemeral.tls_private_key.jwt.private_key_pem
    public_key  = ephemeral.tls_private_key.jwt.public_key_pem
  })
  secret_string_wo_version = 1
}
