<mxfile host="drawio"><diagram name="Istio Ambient, allowed vs blocked"><mxGraphModel dx="1800" dy="1075" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1075" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Istio Ambient: same caller, two attempts, two verdicts" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontColor=#0f172a;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1740" height="36" as="geometry"/></mxCell><mxCell id="c3" value="The frontend sends plain TCP both times. Only the AuthorizationPolicy at the destination ztunnel differs." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#475569;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1740" height="26" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#E1F5E6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1720" height="270" as="geometry"/></mxCell><mxCell id="c5" value="✅ Attempt 1: frontend to balancereader:8080, allowed" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#1E6B34;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="55" y="304" width="900" height="26" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#FDE4E4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1720" height="290" as="geometry"/></mxCell><mxCell id="c7" value="❌ Attempt 2: frontend to accounts-db:5432, blocked" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#A61B1B;fontStyle=1;fontFamily=H